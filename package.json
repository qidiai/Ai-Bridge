{
  "name": "ai-bridge-mcp",
  "version": "1.1.0",
  "description": "AI Bridge 共享中枢:本机常驻 HTTP 服务,所有 AI 编程工具作为客户端接入,提供调度/讨论/记忆/准入管理",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "edge": "node edge-agent.js",
    "lint": "eslint . --ext .js,.mjs",
    "lint:fix": "eslint . --ext .js,.mjs --fix",
    "test": "node test-unit.mjs && node test-workspace.mjs && node test-store-corrupt.mjs && node test-e2e.mjs",
    "test:unit": "node test-unit.mjs",
    "test:ws": "node test-workspace.mjs",
    "test:corrupt": "node test-store-corrupt.mjs",
    "test:e2e": "node test-e2e.mjs"
  },
  "devDependencies": {
    "node-windows": "^1.0.0-beta.8",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.1.1"
  },
  "dependencies": {
    "ws": "^8.21.1"
  },
  "engines": {
    "node": ">=18"
  }
}
